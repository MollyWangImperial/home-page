# Copy this file to .env.local and add a Text to Speech API key.
# Never use a VITE_ prefix for these settings: they belong on the server.
ELEVENLABS_API_KEY=
# Alira's voice and model are set in shared/alira-voice.ts. Uncomment these only to try
# a different voice locally; the voice pack is recorded for the shared one.
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
