# Copy this file to .env.local. Keep server-only secrets without a VITE_ prefix.

# Where the real assessment runs: the Rehyn backend that serves /api/pose/runner.
# HTTPS anywhere, or plain HTTP on localhost. When unset, the dev server uses
# http://localhost:8001 (run D:\rh-release locally) and production uses https://rehyn.onrender.com.
VITE_ASSESSMENT_BASE=http://localhost:8001

# Alira's voice (ElevenLabs). Optional: without a key, messages fall back to the browser voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
