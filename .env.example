# Copy this file to .env.local. Keep server-only secrets without a VITE_ prefix.

# Where the real assessment runs: the Rehyn backend that serves /api/pose/runner.
# HTTPS anywhere, or plain HTTP on localhost. When unset, the dev server uses
# http://localhost:8001 (run D:\rh-release locally) and production uses https://rehyn.onrender.com.
VITE_ASSESSMENT_BASE=http://127.0.0.1:8002

# Alira's voice (ElevenLabs). Lines in server/voice-pack play without a key; the key is only
# needed to record new lines (pnpm voice:bake) or to speak a line that is not recorded yet.
# The voice itself is set in shared/alira-voice.ts.
ELEVENLABS_API_KEY=

# Alira's thinking (Claude). Without a key Alira still understands clear requests, such as
# "restart the survey", on the device. With a key, anything else the patient types is sent to
# Anthropic so Alira can answer and use the app's tools. See docs/alira-agent.md.
ANTHROPIC_API_KEY=

# Alira's Learning (server/alira-learning.ts) sends the data a patient agreed to share to Anthropic so Alira can adjust a few
# bounded exercise and movement-check settings. It is on while developing and off in production unless the host's environment
# sets ALIRA_LEARNING_ENABLED=true (on Render, in the dashboard). Check the privacy notice before turning it on for patients.
# ALIRA_LEARNING_ENABLED=true

# Admin emails from Alira's daily plan review (server/admin-alerts.ts, docs/plan-review.md): a warning sign
# (a lot of pain, or stopping because of feeling unwell) is emailed straight away, and the evening review's
# plan changes once a day. Nothing is sent until all of these are set; alerts wait in the browser until then.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=your address, and
# SMTP_PASS=an app password (Google account > Security > App passwords), never your normal password.
ADMIN_ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Optional: the sender shown on the email (defaults to SMTP_USER).
SMTP_FROM=

# Molly's Progress: the 8pm job (scripts/molly-progress.mjs) publishes its summary to the Render site.
# MOLLY_PUBLISH_URL is your Render service URL; MOLLY_PUBLISH_TOKEN must equal the same variable in the Render dashboard.
MOLLY_PUBLISH_URL=
MOLLY_PUBLISH_TOKEN=
